<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets" Condition="Exists('$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets')" />
  <!-- Every project targets Windows 10 and later and is built hardened: SDL checks (/sdl) and
       Control Flow Guard (/guard:cf). Set here, after each project's own settings, so no project
       or configuration can opt out. tools\verify.ps1 checks the flags in every built binary. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>_WIN32_WINNT=0x0A00;WINVER=0x0A00;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- C++20 for every project (owner, 2026-10-06; std::span in the clipboard parsers) -->
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- /std:c++20 implies /permissive-. Projects that set ConformanceMode=true (lib\Contract.props,
           ICU_Loader) keep it; the legacy MFC code (118 conformance errors) stays /permissive until
           Phase D fixes it. -->
      <ConformanceMode Condition="'%(ClCompile.ConformanceMode)' != 'true'">false</ConformanceMode>
      <!-- /W4 everywhere; the legacy warnings are held by the ratchet in tools\baselines\warnings.tsv -->
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <!-- /ZI (Edit and Continue) cannot be combined with /guard:cf: use a plain program database -->
      <DebugInformationFormat Condition="'%(ClCompile.DebugInformationFormat)' == 'EditAndContinue'">ProgramDatabase</DebugInformationFormat>
    </ClCompile>
  </ItemDefinitionGroup>
  <Target Name="DittoRequireVcpkg" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets')"
           Text="vcpkg not found at '$(VcpkgRoot)'. Set VCPKG_ROOT or pass /p:VcpkgRoot=&lt;path&gt;." />
  </Target>
</Project>
