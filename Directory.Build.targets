<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets" Condition="Exists('$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets')" />
  <!-- Every project targets Windows 10 and later and is built hardened: SDL checks (/sdl) and
       Control Flow Guard (/guard:cf). Set here, after each project's own settings, so no project
       or configuration can opt out. tools\verify.ps1 checks the flags in every built binary. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>_WIN32_WINNT=0x0A00;WINVER=0x0A00;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- C++20 for every project (owner, 2026-10-06; std::span in the clipboard parsers) -->
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- Standard conformance (/permissive-) for every project (Phase D, 2026-10-07). Only the
           untouched third-party C++ sources keep /permissive, per file in the project files. -->
      <ConformanceMode>true</ConformanceMode>
      <!-- /W4 /WX everywhere (owner, 2026-10-07): a warning fails the build. /WX does not make
           every code analysis finding an error; tools\verify.ps1 fails on any finding in the
           build log. Untouched third-party files are silenced per file. -->
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <!-- Headers included with angle brackets (Windows SDK, MFC, the STL, vcpkg's gtest and zlib)
           are external: no warnings and no code analysis for them (/external:anglebrackets
           /external:W0 /analyze:external-). Untouched third-party sources in the repo are
           silenced per file in the project files (README, Decisions). -->
      <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <DisableAnalyzeExternal>true</DisableAnalyzeExternal>
      <SDLCheck>true</SDLCheck>
      <ControlFlowGuard>Guard</ControlFlowGuard>
      <!-- /ZI (Edit and Continue) cannot be combined with /guard:cf: use a plain program database -->
      <DebugInformationFormat Condition="'%(ClCompile.DebugInformationFormat)' == 'EditAndContinue'">ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <!-- linker and librarian warnings are errors too -->
    <Link>
      <TreatLinkerWarningAsErrors>true</TreatLinkerWarningAsErrors>
    </Link>
    <Lib>
      <TreatLibWarningAsErrors>true</TreatLibWarningAsErrors>
    </Lib>
  </ItemDefinitionGroup>
  <Target Name="DittoRequireVcpkg" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets')"
           Text="vcpkg not found at '$(VcpkgRoot)'. Set VCPKG_ROOT or pass /p:VcpkgRoot=&lt;path&gt;." />
  </Target>
</Project>
