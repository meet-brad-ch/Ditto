<?xml version="1.0" encoding="utf-8"?>
<!-- Every project in the repo takes its third-party libraries from vcpkg.json (manifest mode),
     pinned by its builtin-baseline. Static libraries with the dynamic CRT (/MD), matching MFC as a DLL.
     Libraries are linked explicitly per project; vcpkg auto-link is off. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <VcpkgRoot Condition="'$(VcpkgRoot)' == '' and '$(VCPKG_ROOT)' != ''">$(VCPKG_ROOT)</VcpkgRoot>
    <VcpkgRoot Condition="'$(VcpkgRoot)' == ''">C:\vcpkg</VcpkgRoot>
    <!-- ignore a user-wide 'vcpkg integrate install'; this repo wires vcpkg itself -->
    <VCPkgLocalAppDataDisabled>true</VCPkgLocalAppDataDisabled>
    <VcpkgEnabled>true</VcpkgEnabled>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestInstall>true</VcpkgManifestInstall>
    <VcpkgAutoLink>false</VcpkgAutoLink>
    <VcpkgApplocalDeps>false</VcpkgApplocalDeps>
    <VcpkgUseStatic>true</VcpkgUseStatic>
    <VcpkgUseMD>true</VcpkgUseMD>
  </PropertyGroup>
  <Import Project="$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.props" Condition="Exists('$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.props')" />
  <!-- lib\DittoCore headers are visible to every project; linking is by ProjectReference. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)lib\DittoCore;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
