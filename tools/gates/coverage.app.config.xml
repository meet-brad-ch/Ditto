<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft code coverage settings for tools\gates\coverage.ps1, app layer: measure the src\
     files that AppTests compiles (reported, no minimum), by dynamic native instrumentation. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*\\AppTests\.exe$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Include>
        <Source>.*\\src\\.*</Source>
      </Include>
    </Sources>
    <EnableStaticNativeInstrumentation>False</EnableStaticNativeInstrumentation>
    <EnableDynamicNativeInstrumentation>True</EnableDynamicNativeInstrumentation>
  </CodeCoverage>
</Configuration>
