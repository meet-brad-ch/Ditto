<?xml version="1.0" encoding="utf-8"?>
<!-- DittoTests: GoogleTest unit tests for lib\DittoCore. Compiles the DittoCore sources itself so
     that the Release configuration instruments them with AddressSanitizer (/fsanitize=address). -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{7B2D3054-9F68-4D2E-8C3B-4E5F60718293}</ProjectGuid>
    <RootNamespace>DittoTests</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <EnableASAN Condition="'$(Configuration)'=='Release'">true</EnableASAN>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="..\lib\Contract.props" />
  <ItemDefinitionGroup>
    <Link>
      <SubSystem>Console</SubSystem>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <Link>
      <AdditionalDependencies>gtest.lib;gtest_main.lib;zlibd.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <!-- gtest from vcpkg is not ASan-built; the STL container annotations must match across all
           objects (LNK2038). Heap/stack overflow detection on raw memory is unaffected. -->
      <PreprocessorDefinitions>NDEBUG;_DISABLE_STL_ANNOTATION;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>gtest.lib;gtest_main.lib;zlib.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="..\lib\DittoCore\ByteCursor.cpp" />
    <ClCompile Include="..\lib\DittoCore\CfHtml.cpp" />
    <ClCompile Include="..\lib\DittoCore\ClipText.cpp" />
    <ClCompile Include="..\lib\DittoCore\DatabasePath.cpp" />
    <ClCompile Include="..\lib\DittoCore\DibHeader.cpp" />
    <ClCompile Include="..\lib\DittoCore\DropBlockReader.cpp" />
    <ClCompile Include="..\lib\DittoCore\DtoCodec.cpp" />
    <ClCompile Include="..\lib\DittoCore\FileDataRecord.cpp" />
    <ClCompile Include="..\lib\DittoCore\FileDropList.cpp" />
    <ClCompile Include="..\lib\DittoCore\GlobalBytes.cpp" />
    <ClCompile Include="..\lib\DittoCore\GlobalFileDrop.cpp" />
    <ClCompile Include="..\lib\DittoCore\GlobalLockGuard.cpp" />
    <ClCompile Include="..\lib\DittoCore\RtfJoin.cpp" />
    <ClCompile Include="..\lib\DittoCore\RtfNormalizer.cpp" />
    <ClCompile Include="CfHtmlTests.cpp" />
    <ClCompile Include="ClipTextTests.cpp" />
    <ClCompile Include="DatabasePathTests.cpp" />
    <ClCompile Include="DibHeaderTests.cpp" />
    <ClCompile Include="DtoCodecTests.cpp" />
    <ClCompile Include="FileDataRecordTests.cpp" />
    <ClCompile Include="FileDropListTests.cpp" />
    <ClCompile Include="GlobalBytesTests.cpp" />
    <ClCompile Include="GlobalFileDropTests.cpp" />
    <ClCompile Include="RtfTests.cpp" />
    <ClCompile Include="TextJoinTests.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
